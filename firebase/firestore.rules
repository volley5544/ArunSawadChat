rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /user_custom/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /SawadChatRoom/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /SawadChatRoom/{parent}/ChatMessages/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/ChatMessages/{document} {
      allow read: if true;
    }


    match /WorkFollowUpChatRoom/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if true;
      allow delete: if true;
    }

    match /WorkFollowUpChatRoom/{parent}/Message/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if true;
      allow delete: if true;
    }

    match /{path=**}/Message/{document} {
      allow read: if true;
    }

  }
}
